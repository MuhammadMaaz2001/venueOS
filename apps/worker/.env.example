NODE_ENV=development
DATABASE_URL=postgresql://venueos_app:app_password@localhost:5432/venueos
# auth.purge job only (role venueos_auth, through AuthDb)
AUTH_DATABASE_URL=postgresql://venueos_auth:auth_password@localhost:5432/venueos
# The worker's pg-boss connection (role venueos_jobs: read/write on the pgboss schema only)
JOBS_DATABASE_URL=postgresql://venueos_jobs:jobs_password@localhost:5432/venueos

# Email: smtp (Mailpit in development) or ses (staging/production; credentials from the AWS provider chain)
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM_ADDRESS=bookings@venueos.app
# Required when EMAIL_PROVIDER=ses
AWS_REGION=ap-south-1

S3_BUCKET=venueos-local
SENTRY_DSN=
LOG_LEVEL=info
# How often an idle worker polls the queue, and how many jobs of one queue run at once
JOB_POLLING_INTERVAL_SECONDS=2
JOB_CONCURRENCY=4
