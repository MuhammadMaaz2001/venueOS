NODE_ENV=development
DATABASE_URL=postgresql://venueos_app:app_password@localhost:5432/venueos
# auth.purge job only (role venueos_auth, through AuthDb)
AUTH_DATABASE_URL=postgresql://venueos_auth:auth_password@localhost:5432/venueos
# The worker's pg-boss connection (role venueos_jobs: read/write on the pgboss schema only)
JOBS_DATABASE_URL=postgresql://venueos_jobs:jobs_password@localhost:5432/venueos

# Opens secret variables of queued emails (links with tokens). Same value as the API's. Generate one key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEYS={"active":"k1","keys":{"k1":"REPLACE_WITH_32_RANDOM_BYTES_BASE64"}}

# The web app's origin, for the links in internal emails (same as the API's APP_ORIGIN; required in production)
APP_ORIGIN=http://localhost:3000

# Email: smtp (Mailpit in development) or ses (staging/production; credentials from the AWS provider chain)
EMAIL_PROVIDER=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM_ADDRESS=bookings@venueos.app
# Required when EMAIL_PROVIDER=ses
AWS_REGION=ap-south-1

# Generated files (PDFs). Locally this is a SeaweedFS S3 gateway (docker compose up -d s3): S3 API on :9100.
# In staging/production leave S3_ENDPOINT, S3_FORCE_PATH_STYLE and S3_SSE unset (real S3, SSE-S3), set S3_REGION,
# and give the worker's ECS TASK ROLE access to the bucket. NEVER set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY there.
S3_BUCKET=venueos-local
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9100
S3_FORCE_PATH_STYLE=true
S3_SSE=none
# The key of docker/seaweedfs/s3.json. LOCAL S3 ONLY (the AWS SDK reads these two from the environment).
AWS_ACCESS_KEY_ID=venueos
AWS_SECRET_ACCESS_KEY=venueos-local-secret

# PDF rendering (Playwright Chromium: `pnpm --filter @venueos/worker exec playwright install chromium`)
PDF_CONCURRENCY=2
PDF_RENDER_TIMEOUT_MS=30000
# Set to false on a worker that must not fire cron schedules (auth.purge, dead-letter check)
SCHEDULER_ENABLED=true
SENTRY_DSN=
LOG_LEVEL=info
# How often an idle worker polls the queue, and how many jobs of one queue run at once
JOB_POLLING_INTERVAL_SECONDS=2
JOB_CONCURRENCY=4
