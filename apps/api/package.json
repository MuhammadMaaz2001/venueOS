{
  "name": "@venueos/api",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node ../../scripts/dev-node.mjs --env-file-if-exists=.env",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:export": "tsc -p tsconfig.openapi.json && node node_modules/.cache/openapi-build/tools/export-openapi.js ../../packages/api-client/openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/throttler": "6.8.0",
    "@venueos/db": "workspace:*",
    "@venueos/shared": "workspace:*",
    "helmet": "8.3.0",
    "nestjs-cls": "7.0.2",
    "nestjs-pino": "5.3.2",
    "nestjs-zod": "5.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "3.2.7"
  }
}
