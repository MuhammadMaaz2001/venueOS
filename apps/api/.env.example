# Copy to .env — fake values only. Real values come from the secret store.
NODE_ENV=development
PORT=4000
# Tenant work (role venueos_app: no BYPASSRLS, cannot read the auth tables)
DATABASE_URL=postgresql://venueos_app:app_password@localhost:5432/venueos
# AuthModule only (role venueos_auth): sessions, credentials, tokens, invitations, login attempts
AUTH_DATABASE_URL=postgresql://venueos_auth:auth_password@localhost:5432/venueos
APP_ORIGIN=http://localhost:3000
# JSON keyring for AES-256-GCM field encryption: {"active":"<keyId>","keys":{"<keyId>":"<base64 32-byte key>"}}
FIELD_ENCRYPTION_KEYS={"active":"k1","keys":{"k1":"change-me-base64-32-byte-key"}}
S3_BUCKET=venueos-local
AWS_REGION=ap-south-1
SENTRY_DSN=
