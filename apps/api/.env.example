# Copy to .env — fake values only. Real values come from the secret store.
# The API validates these at startup and refuses to boot when a required one is missing or invalid.
NODE_ENV=development
PORT=4000
# Required. Tenant work (role venueos_app: no BYPASSRLS, cannot read the auth tables)
DATABASE_URL=postgresql://venueos_app:app_password@localhost:5432/venueos
# AuthModule only (role venueos_auth): sessions, credentials, tokens, invitations, login attempts
AUTH_DATABASE_URL=postgresql://venueos_auth:auth_password@localhost:5432/venueos
# Required. The web app's origin: bare scheme://host[:port], no path, no trailing slash. State-changing
# requests must send exactly this Origin (CSRF check).
APP_ORIGIN=http://localhost:3000
# Required. JSON keyring for AES-256-GCM sealing (secret email links now, sensitive fields later): {"active":"<keyId>","keys":{"<keyId>":"<base64 of 32 random bytes>"}}
# Generate one key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"; the worker needs the same keyring.
FIELD_ENCRYPTION_KEYS={"active":"k1","keys":{"k1":"REPLACE_WITH_32_RANDOM_BYTES_BASE64"}}
S3_BUCKET=venueos-local
AWS_REGION=ap-south-1
SENTRY_DSN=

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Swagger UI at /docs is always on outside production; set true to expose it in production.
SWAGGER_ENABLED=false
# Number of proxies in front of the API that add an X-Forwarded-For entry (client IP for throttling and
# logs). Must match the real hop count of the environment: 0 locally (browser -> Next dev -> API),
# 1 behind ALB -> web -> API. A wrong value makes all users share one throttle bucket (too low) or
# lets callers spoof their IP (too high). See docs/08-deployment-and-ops.md.
TRUST_PROXY=0
# In-memory rate limit per client IP: requests per window.
THROTTLE_LIMIT=300
THROTTLE_TTL_MS=60000
