# Read by docker compose only (the apps have their own .env files).
# Host port for the local Postgres container. Use e.g. 5433 if something else owns 5432,
# and put the same port into the DATABASE URLs of the other .env files.
POSTGRES_PORT=5432

# Turborepo anonymous telemetry opt-out. Turborepo does NOT read .env files: export this in your
# shell (or run `pnpm exec turbo telemetry disable` once) for it to take effect.
TURBO_TELEMETRY_DISABLED=1
