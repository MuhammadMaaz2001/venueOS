# Read by docker compose, the web dev server (apps/web/scripts/next-port.mjs) and the Playwright config; the apps
# have their own .env files.
# Port of the web app: `pnpm dev` (next dev) and the Docker web container. Default 3000. When you move it, move the
# rest with it: PORT of apps/api/.env (default 4000), API_INTERNAL_URL in apps/web/.env, and APP_ORIGIN in apps/api/.env
# and apps/worker/.env must name the same ports (README, "Getting started"). CI keeps 3000 / 4000.
WEB_PORT=3000
# Host port for the local Postgres container. Use e.g. 5433 if something else owns 5432,
# and put the same port into the DATABASE URLs of the other .env files.
POSTGRES_PORT=5432

# Turborepo anonymous telemetry opt-out. Turborepo does NOT read .env files: export this in your
# shell (or run `pnpm exec turbo telemetry disable` once) for it to take effect.
TURBO_TELEMETRY_DISABLED=1
