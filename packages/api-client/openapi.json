      }
    },
    "/v1/me/switch-tenant": {
      "post": {
        "description": "Rotates the session token (a new cookie is set). A workspace I am not a member of is 404.",
        "operationId": "MeController_switchTenant",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
