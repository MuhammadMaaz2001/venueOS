          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffMemberResponseDto"
                }
              }
            }
          }
        },
        "summary": "Change a member: role, venues, active",
        "tags": [
          "staff"
        ]
      }
