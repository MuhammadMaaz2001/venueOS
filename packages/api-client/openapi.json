                "name",
                "permissions",
                "limits",
                "isSystem",
                "rev",
                "createdAt",
                "updatedAt"
              ]
            }
          },
          "nextCursor": {
            "type": "null"
          }
        },
        "required": [
          "data",
          "nextCursor"
        ]
      },
