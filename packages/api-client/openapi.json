                  "$ref": "#/components/schemas/MeResponseDto"
                }
              }
            }
          }
        },
        "summary": "Work in another of my workspaces",
        "tags": [
          "me"
        ]
      }
    },
    "/v1/me/invitations/accept": {
      "post": {
        "operationId": "MeController_accept",
        "parameters": [],
        "requestBody": {
          "required": true,
