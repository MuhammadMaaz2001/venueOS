  },
  "info": {
    "title": "venueOS API",
    "description": "",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              },
              "queue": {
                "type": "string",
                "enum": [
                  "up",
                  "down"
                ]
              }
            },
            "required": [
              "database",
              "queue"
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "SignupDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          },
          "tenantName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "country": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "currency": {
            "type": "string"
          },
          "timezone": {
            "type": "string",
            "maxLength": 64
          },
          "defaultLocale": {
            "default": "en",
            "type": "string",
            "pattern": "^[a-z]{2,3}$"
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "tenantName",
          "country",
          "currency",
          "timezone"
        ]
      },
      "AcceptedResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{20,128}$"
          }
        },
        "required": [
          "token"
        ]
      },
      "EmailOnlyDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "nullable": true
              },
              "emailVerified": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "emailVerified"
            ]
          },
          "activeTenantId": {
            "type": "string",
            "nullable": true
          },
          "tenants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "TRIAL",
                    "ACTIVE",
                    "PAST_DUE",
                    "SUSPENDED",
                    "CANCELLED"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "slug",
                "status"
              ]
            }
          }
        },
        "required": [
          "user",
          "activeTenantId",
          "tenants"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{20,128}$"
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "token",
          "newPassword"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "newPassword": {
            "type": "string",
            "minLength": 10,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "nullable": true
              },
              "emailVerified": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "emailVerified"
            ]
          },
          "activeTenantId": {
            "type": "string",
            "nullable": true
          },
          "access": {
            "type": "object",
            "properties": {
              "tenantId": {
                "type": "string"
              },
              "roleName": {
                "type": "string"
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "venueIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "limits": {
                "type": "object",
                "properties": {
                  "maxDiscountPct": {
                    "type": "number"
                  }
                },
                "required": [
                  "maxDiscountPct"
                ]
              }
            },
            "required": [
              "tenantId",
              "roleName",
              "permissions",
              "venueIds",
              "limits"
            ],
            "nullable": true
          }
        },
        "required": [
          "user",
          "activeTenantId",
          "access"
        ]
      },
      "MeTenantsResponseDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "TRIAL",
                    "ACTIVE",
                    "PAST_DUE",
                    "SUSPENDED",
                    "CANCELLED"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "slug",
                "status"
              ]
            }
          },
          "activeTenantId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "data",
          "activeTenantId"
        ]
      },
      "SwitchTenantDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          }
        },
        "required": [
          "tenantId"
        ]
