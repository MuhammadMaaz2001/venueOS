                "$ref": "#/components/schemas/VerifyEmailDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Confirm an email address with the token from the email",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/resend-verification": {
      "post": {
        "operationId": "AuthController_resendVerification",
