{
  "name": "@venueos/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed client generated from the API's OpenAPI spec: generated types plus an openapi-fetch client that adds the CSRF header",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "generate": "pnpm --filter @venueos/api openapi:export && openapi-typescript openapi.json -o src/schema.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
