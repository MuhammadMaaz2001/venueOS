{
  "name": "@venueos/templates",
  "version": "0.0.0",
  "private": true,
  "description": "Email and PDF HTML templates (quotation, receipt, event sheet); filled in by later tasks",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
