{
  // Typecheck (source, specs, vitest config). Emit uses tsconfig.build.json.
  // No ambient types on purpose: this package is imported by the browser and by Node.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "noEmit": true
  },
  "include": ["src", "vitest.config.ts"]
}
