# Migrations and seed run as the migrator role (owns the schema; NOT a superuser).
# prisma.config.ts reads MIGRATE_DATABASE_URL. Runtime URLs (DATABASE_URL, AUTH_DATABASE_URL,
# JOBS_DATABASE_URL) belong to the apps, not to this package.
MIGRATE_DATABASE_URL=postgresql://venueos_migrator:migrator_password@localhost:5432/venueos
# Constraint tests: superuser URL used only to create/drop a throwaway database
VENUEOS_TEST_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
